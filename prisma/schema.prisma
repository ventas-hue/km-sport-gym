generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Client {
  id               String       @id @default(cuid())
  firstName        String
  lastName         String
  phone            String
  email            String?
  emergencyContact String?
  birthDate        DateTime?
  notes            String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  memberships      Membership[]
  dayPasses        DayPass[]
  sales            Sale[]
}

model Package {
  id           String       @id @default(cuid())
  name         String
  description  String?
  price        Float
  durationDays Int
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  memberships  Membership[]
}

model Membership {
  id            String   @id @default(cuid())
  clientId      String
  packageId     String
  startDate     DateTime
  endDate       DateTime
  amountPaid    Float
  paymentMethod String   @default("efectivo")
  status        String   @default("active")
  createdAt     DateTime @default(now())
  client        Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  package       Package  @relation(fields: [packageId], references: [id])
}

model DayPass {
  id         String   @id @default(cuid())
  clientId   String?
  clientName String?
  date       DateTime @default(now())
  amountPaid Float
  createdAt  DateTime @default(now())
  client     Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
}

model Product {
  id          String   @id @default(cuid())
  name        String
  description String?
  price       Float
  stock       Int      @default(0)
  category    String   @default("general")
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  sales         Sale[]
  purchaseItems PurchaseItem[]
}

model Sale {
  id          String   @id @default(cuid())
  productId   String
  clientId    String?
  quantity    Int      @default(1)
  totalAmount Float
  createdAt   DateTime @default(now())
  product     Product  @relation(fields: [productId], references: [id])
  client      Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
}

model Purchase {
  id            String         @id @default(cuid())
  supplier      String
  notes         String?
  totalAmount   Float
  paymentMethod String         @default("efectivo")
  createdAt     DateTime       @default(now())
  items         PurchaseItem[]
}

model PurchaseItem {
  id         String   @id @default(cuid())
  purchaseId String
  productId  String
  quantity   Int
  unitCost   Float
  subtotal   Float
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id])
}

model Expense {
  id            String   @id @default(cuid())
  description   String
  category      String   @default("general")
  amount        Float
  paymentMethod String   @default("efectivo")
  date          DateTime @default(now())
  notes         String?
  createdAt     DateTime @default(now())
}
